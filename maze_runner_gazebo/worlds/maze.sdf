<?xml version="1.0"?>
<!-- The Maze Runner garden maze (32 x 60 m), same coordinates as the old Apolo world.
     Walls come from meshes/maze.stl; the EKF builds its line map from the same mesh. -->
<sdf version="1.11">
  <world name="maze">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.6 0.75 0.9 1</background>
      <grid>false</grid>
      <shadows>true</shadows>
      <sky/>
    </scene>

    <!-- High (about 75 deg) late-morning sun from the south-east: 4 m walls in 2.8 m
         corridors cast short shadows, so the corridors stay lit. -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>16 30 50 0 0 0</pose>
      <diffuse>1.0 0.97 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.2 0.18 -0.96</direction>
    </light>

    <!-- Soft fill from the opposite side, no shadows: lifts the shaded wall faces. -->
    <light type="directional" name="fill">
      <cast_shadows>false</cast_shadows>
      <pose>16 30 50 0 0 0</pose>
      <diffuse>0.35 0.38 0.45 1</diffuse>
      <specular>0 0 0 1</specular>
      <direction>0.3 -0.3 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <pose>16 30 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>60 90</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>60 90</size></plane></geometry>
          <material>
            <ambient>0.55 0.45 0.3 1</ambient>
            <diffuse>0.6 0.5 0.33 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="maze">
      <static>true</static>
      <link name="walls">
        <collision name="collision">
          <geometry><mesh><uri>meshes/maze.stl</uri></mesh></geometry>
        </collision>
        <visual name="visual">
          <geometry><mesh><uri>meshes/maze.stl</uri></mesh></geometry>
          <material>
            <ambient>0.2 0.5 0.25 1</ambient>
            <diffuse>0.25 0.6 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
