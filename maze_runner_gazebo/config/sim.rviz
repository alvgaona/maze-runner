Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: false
    # The map: inflated planner grid under the true walls
    - Class: rviz_default_plugins/Map
      Name: Planner grid
      Enabled: true
      Alpha: 0.25
      Color Scheme: map
      Topic:
        Value: /planner/grid
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Marker
      Name: Walls (truth)
      Enabled: true
      Topic:
        Value: /map_walls
        Durability Policy: Transient Local
    # SLAM mode only: walls mapped so far (orange)
    - Class: rviz_default_plugins/Marker
      Name: SLAM map
      Enabled: true
      Topic:
        Value: /ekf/landmarks
    # Lines RANSAC found in the current scan (cyan)
    - Class: rviz_default_plugins/Marker
      Name: Detections
      Enabled: true
      Topic:
        Value: /ekf/detections
    - Class: rviz_default_plugins/LaserScan
      Name: Scan
      Enabled: true
      Topic:
        Value: /scan
      Size (m): 0.04
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 255; 0
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Alpha: 0.6
      Description Topic:
        Value: /robot_description
    # REP 105 chain: map -> odom -> base_footprint, plus the scan frame
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: true
      Marker Scale: 2
      Frames:
        All Enabled: false
        map:
          Value: true
        odom:
          Value: true
        base_footprint:
          Value: true
        laser:
          Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Ground truth
      Enabled: true
      Topic:
        Value: /ground_truth/odom
      Keep: 1
      Shape:
        Value: Arrow
        Color: 0; 220; 0
      Covariance:
        Value: false
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: EKF
      Enabled: true
      Topic:
        Value: /ekf/pose
    - Class: rviz_default_plugins/Odometry
      Name: Wheel odometry
      Enabled: false
      Topic:
        Value: /diff_drive_controller/odom
      Keep: 50
    - Class: rviz_default_plugins/Path
      Name: Plan
      Enabled: true
      Color: 255; 170; 0
      Topic:
        Value: /plan
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Path
      Name: Reference
      Enabled: true
      Topic:
        Value: /nmpc/reference
        Durability Policy: Transient Local
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      # Whole maze; set Target Frame to base_footprint in Views to follow the robot
      X: 16.5
      Y: 30
      Scale: 15
