<?xml version="1.0"?>
<robot name="maze_runner" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Husarion ROSbot XL with mecanum wheels and the Autonomy kit lidar (RPLIDAR S3).
       Geometry, masses, meshes and wheel friction from husarion/rosbot_ros and
       husarion/husarion_components_description (Apache-2.0, see meshes/LICENSE.husarion).
       Driven as a differential robot, left pair vs right pair. -->

  <!-- Keep wheel_radius in sync with config/controllers.yaml -->
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_separation_x" value="0.170"/>
  <xacro:property name="wheel_separation_y" value="0.270"/>
  <xacro:property name="wheel_thickness" value="0.05"/>
  <xacro:property name="mesh_dir" value="file://$(find maze_runner_description)/meshes"/>

  <link name="base_footprint"/>

  <!-- base_link is Husarion's body_link, at wheel axle height -->
  <link name="base_link">
    <visual>
      <geometry><mesh filename="${mesh_dir}/rosbot_xl_body.dae"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="${mesh_dir}/rosbot_xl_body_collision.stl"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.0358"/>
      <mass value="3.5"/>
      <inertia ixx="0.01393" ixy="-0.000020968097" ixz="0.000010399694"
               iyy="0.01081" iyz="0.000059372953" izz="0.02048"/>
    </inertial>
  </link>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}"/>
  </joint>

  <!-- fdir is the roller direction in base_link; mecanum is faked with anisotropic friction -->
  <xacro:macro name="wheel" params="side x y mesh yaw fdir">
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="${x} ${y} 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="1.5" velocity="30.0"/>
      <dynamics damping="0.001" friction="0.001"/>
    </joint>
    <link name="${side}_wheel_link">
      <visual>
        <origin rpy="0 0 ${yaw}"/>
        <geometry><mesh filename="${mesh_dir}/rosbot_xl_mecanum_${mesh}.dae"/></geometry>
      </visual>
      <collision>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_thickness}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.4"/>
        <inertia ixx="0.0003145" ixy="0" ixz="0" iyy="0.0004561" iyz="0" izz="0.0003145"/>
      </inertial>
    </link>
    <gazebo reference="${side}_wheel_link" xmlns:gz="http://gazeborobotics.org/schema">
      <collision>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.2</mu2>
              <slip1>0.035</slip1>
              <slip2>0</slip2>
              <fdir1 gz:expressed_in="base_link">${fdir}</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </gazebo>
  </xacro:macro>

  <xacro:wheel side="fl" x="${wheel_separation_x/2}" y="${wheel_separation_y/2}" mesh="b" yaw="${pi}" fdir="1 -1 0"/>
  <xacro:wheel side="fr" x="${wheel_separation_x/2}" y="${-wheel_separation_y/2}" mesh="a" yaw="${pi}" fdir="1 1 0"/>
  <xacro:wheel side="rl" x="${-wheel_separation_x/2}" y="${wheel_separation_y/2}" mesh="a" yaw="0" fdir="1 1 0"/>
  <xacro:wheel side="rr" x="${-wheel_separation_x/2}" y="${-wheel_separation_y/2}" mesh="b" yaw="0" fdir="1 -1 0"/>

  <!-- RPLIDAR S3 on the top cover, as in the Autonomy kit. lidar_link is the bottom of the sensor. -->
  <link name="lidar_link">
    <visual>
      <!-- glTF is Y-up -->
      <origin rpy="${pi/2} 0 0"/>
      <geometry><mesh filename="${mesh_dir}/rplidar_s3.glb"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 ${0.0413/2}"/>
      <geometry><box size="0.0556 0.0556 0.0413"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${0.0413/2 + 0.0018237}"/>
      <mass value="0.115033"/>
      <inertia ixx="0.00004115765" ixy="0" ixz="0" iyy="0.00004115765" iyz="0" izz="0.00004956023"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <!-- cover_link is 0.08345 above body_link; S3 sits 1 cm behind its center -->
    <origin xyz="-0.01 0 0.08345"/>
  </joint>

  <!-- Scan frame at the optical center, yawed 180 deg like the real driver's frame -->
  <link name="laser"/>
  <joint name="laser_joint" type="fixed">
    <parent link="lidar_link"/>
    <child link="laser"/>
    <origin xyz="0 0 0.0305" rpy="0 0 ${pi}"/>
  </joint>

  <gazebo reference="laser">
    <sensor name="lidar" type="gpu_lidar">
      <topic>scan</topic>
      <gz_frame_id>laser</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <!-- 32 kHz sampling at 10 Hz gives 3200 points, 0.1125 deg apart -->
            <samples>3200</samples>
            <min_angle>${-pi}</min_angle>
            <max_angle>${pi - 2*pi/3200}</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.05</min>
          <max>40.0</max>
          <resolution>0.01</resolution>
        </range>
        <!-- Datasheet accuracy is +-30 mm, taken as about 2 sigma -->
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.015</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <xacro:macro name="wheel_control" params="side">
    <joint name="${side}_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <ros2_control name="maze_runner_system" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <xacro:wheel_control side="fl"/>
    <xacro:wheel_control side="fr"/>
    <xacro:wheel_control side="rl"/>
    <xacro:wheel_control side="rr"/>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find maze_runner_description)/config/controllers.yaml</parameters>
    </plugin>
    <!-- Sim-only ground truth, used for evaluation, never for control -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>
  </gazebo>
</robot>
