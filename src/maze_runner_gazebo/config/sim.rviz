Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
    - Class: rviz_default_plugins/LaserScan
      Name: Scan
      Enabled: true
      Topic:
        Value: /scan
      Size (m): 0.05
      Style: Points
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic:
        Value: /diff_drive_controller/odom
      Keep: 50
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: EKF
      Enabled: true
      Topic:
        Value: /ekf/pose
    - Class: rviz_default_plugins/Marker
      Name: SLAM map
      Enabled: true
      Topic:
        Value: /ekf/landmarks
    - Class: rviz_default_plugins/Path
      Name: Reference
      Enabled: true
      Topic:
        Value: /nmpc/reference
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Path
      Name: Plan
      Enabled: true
      Color: 255; 170; 0
      Topic:
        Value: /plan
        Durability Policy: Transient Local
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 60
