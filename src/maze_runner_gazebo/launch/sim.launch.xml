<launch>
  <arg name="world" default="$(find-pkg-share maze_runner_gazebo)/worlds/maze.sdf"/>
  <arg name="gui" default="true"/>
  <arg name="rviz" default="true"/>
  <arg name="localization" default="true"/>
  <!-- Path following needs localization (map -> odom) -->
  <arg name="controller" default="false"/>
  <arg name="path" default="$(find-pkg-share maze_runner_gazebo)/config/maze_path.yaml"/>
  <!-- Default start: first point of the Apolo trajDirect route -->
  <arg name="x" default="2.393"/>
  <arg name="y" default="4.307"/>
  <arg name="yaw" default="0.045"/>
  <!-- Bag output directory; empty disables recording. Ctrl-C the launch to close it. -->
  <arg name="bag" default=""/>

  <!-- Server and GUI run as separate processes: required on macOS, harmless on Linux -->
  <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
    <arg name="gz_args" value="-s -r $(var world)"/>
  </include>
  <executable cmd="gz sim -g" if="$(var gui)" output="screen"/>

  <node pkg="robot_state_publisher" exec="robot_state_publisher" output="screen">
    <param name="robot_description"
           value="$(command 'xacro $(find-pkg-share maze_runner_description)/urdf/maze_runner.urdf.xacro')"/>
    <param name="use_sim_time" value="true"/>
  </node>

  <node pkg="ros_gz_sim" exec="create" output="screen"
        args="-topic robot_description -name maze_runner -x $(var x) -y $(var y) -z 0.05 -Y $(var yaw)"/>

  <node pkg="ros_gz_bridge" exec="parameter_bridge" output="screen">
    <param name="config_file" value="$(find-pkg-share maze_runner_gazebo)/config/bridge.yaml"/>
    <param name="use_sim_time" value="true"/>
  </node>

  <node pkg="controller_manager" exec="spawner" output="screen"
        args="joint_state_broadcaster diff_drive_controller --controller-manager-timeout 60 --switch-timeout 30
              --param-file $(find-pkg-share maze_runner_description)/config/controllers.yaml">
    <param name="use_sim_time" value="true"/>
  </node>

  <node pkg="maze_runner_nodes" exec="ekf_lines_node" output="screen" if="$(var localization)">
    <param name="world_file" value="$(var world)"/>
    <param name="initial_pose" value="[$(var x), $(var y), $(var yaw)]"/>
    <param name="use_sim_time" value="true"/>
  </node>

  <node pkg="maze_runner_nodes" exec="nmpc_cbf_node" output="screen" if="$(var controller)">
    <param from="$(var path)"/>
    <param name="use_sim_time" value="true"/>
  </node>

  <node pkg="rviz2" exec="rviz2" if="$(var rviz)"
        args="-d $(find-pkg-share maze_runner_gazebo)/config/sim.rviz">
    <param name="use_sim_time" value="true"/>
  </node>
  <!-- Everything needed to score a run offline: truth vs EKF, commands, scans, timing -->
  <executable if="$(eval '\'$(var bag)\' != \'\'')" output="screen"
              cmd="ros2 bag record -s mcap -o $(var bag) --use-sim-time --topics
                   /clock /tf /tf_static /scan /joint_states
                   /ground_truth/odom /ekf/pose /diff_drive_controller/odom
                   /diff_drive_controller/cmd_vel /diff_drive_controller/cmd_vel_out
                   /nmpc/reference /nmpc/solve_time_ms"/>
</launch>
